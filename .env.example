# MINDLET 환경 변수 예시 — 실제 값은 .env.local(버전 관리 제외)에만 입력하세요.

# Supabase 연결 (브라우저 공개 조회용)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# 서버 전용 비밀값 — NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# bcrypt 해시: npm run hash-admin-password -- "관리자암호"
# .env.local 에서는 해시의 $ 를 \$ 로 이스케이프해야 합니다 (Vercel 대시보드에는 원본 그대로 입력).
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH
# 32자 이상 무작위 문자열: npm run gen-session-secret
ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET